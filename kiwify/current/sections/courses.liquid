{% if section.settings.all_accessible_courses %}{% assign courses = all_courses_values | where: 'user_data.visible', true | sort_natural: 'name' %}{% else %}{% assign filtered_blocks = section.block_order | reject_exp: 'block_id', 'all_courses[section.blocks[block_id].settings.course_id] == undefined' | reject_exp: 'block_id', 'all_courses[section.blocks[block_id].settings.course_id].user_data.visible == false and all_courses[section.blocks[block_id].settings.course_id].custom_offer.enabled == false and not all_courses[section.blocks[block_id].settings.course_id].custom_offer.external_link' %}{% assign courses = '' | split: ',' %}{% for block_id in filtered_blocks %}{% assign courses = courses | push: all_courses[section.blocks[block_id].settings.course_id] %}{% endfor %}{% endif %}
{% if courses.size > 0 or is_preview %}<section id="section__{{ section.id }}" class="kiwi-section relative z-0 hover:z-10 has-[:focus]:z-20 px-6 md:px-12 pb-6 md:pb-12 content-section content-section--courses" data-kiwi-section-id="{{ section.id }}"><div class="pt-8"><h2 id="section__{{ section.id }}__title" class="kiwi-section__title font-semibold text-xl drop-shadow-hard-light dark:drop-shadow-hard mb-1 sm:mb-3 flex flex-row items-center gap-2 relative z-20">{{ section.settings.title }}</h2>{% if courses.size > 0 %}{% liquid assign section_items = courses assign should_display_progress = true assign is_horizontal = false if section.settings.items_layout == 'landscape' assign is_horizontal = true endif assign percentage_field = 'progress' assign path_format = '/{id}' %}{% render 'cards', section: section, section_items: section_items, is_preview: is_preview, source: source, should_display_progress: should_display_progress, is_horizontal: is_horizontal, percentage_field: percentage_field, path_format: path_format %}{% endif %}</div></section>{% endif %}
{% schema %}
{"name":"t:sections.courses.section_title","settings":[{"type":"text","id":"title","label":"t:sections.courses.title.label","placeholder":"t:sections.courses.title.placeholder"},{"type":"select","id":"items_variant","label":"t:sections.courses.items_variant.label","options":[{"value":"content_over","label":"t:sections.courses.items_variant.content_over","kiwi_extra":{"icon":"fas fa-eye"}},{"value":"content_hidden","label":"t:sections.courses.items_variant.content_hidden","kiwi_extra":{"icon":"fas fa-eye-slash"}},{"value":"mouse_hover","label":"t:sections.courses.items_variant.mouse_hover","kiwi_extra":{"icon":"CursorClickIcon"}}],"kiwi_extra":{"labeled":false},"default":"content_over"},{"type":"select","id":"items_layout","label":"t:sections.courses.items_layout.label","options":[{"value":"portrait","label":"t:sections.courses.items_layout.portrait","kiwi_extra":{"icon":"fa fa-portrait"}},{"value":"landscape","label":"t:sections.courses.items_layout.landscape","kiwi_extra":{"icon":"fa fa-image"}}],"kiwi_extra":{"labeled":false},"default":"portrait"},{"type":"checkbox","id":"all_accessible_courses","label":"t:sections.courses.all_accessible_courses.label","default":false}],"kiwi_extra":{"icon":"fas fa-graduation-cap","blocks_hidden_if":{"setting":"all_accessible_courses","value":true}},"blocks":[{"type":"course","name":"t:sections.courses.course_id.label","settings":[{"type":"course","id":"course_id","label":"t:sections.courses.course_id.label","placeholder":"t:sections.courses.course_id.placeholder","kiwi_extra":{"icon":"fas fa-book"}}]}]}
{% endschema %}
