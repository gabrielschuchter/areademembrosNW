{% assign filtered_last_watched_lessons_ids = last_watched_lessons | reject_exp: 'lesson_id', 'all_lessons[lesson_id] == undefined' %}{% assign has_any_visible_lesson = filtered_last_watched_lessons_ids | has_exp: 'lesson_id', 'all_lessons[lesson_id].user_data.visible == true' %}
{% if has_any_visible_lesson or is_preview %}{% assign filtered_last_watched_lessons = '' | split: ',' %}{% for lesson_id in filtered_last_watched_lessons_ids %}{% assign filtered_last_watched_lessons = filtered_last_watched_lessons | push: all_lessons[lesson_id] %}{% endfor %}<section id="section__{{ section.id }}" class="kiwi-section relative z-0 hover:z-10 has-[:focus]:z-20 px-6 md:px-12 pb-6 md:pb-12 content-section content-section--continue_watching" data-kiwi-section-id="{{ section.id }}"><div class="pt-8"><h2 id="section__{{ section.id }}__title" class="kiwi-section__title font-semibold text-xl drop-shadow-hard-light dark:drop-shadow-hard mb-1 sm:mb-3 flex flex-row items-center gap-2 relative z-20">{{ 'continue_watching.title' | t }}</h2></div>{% liquid if is_preview assign fake_lesson_name = 'continue_watching.fake_lesson' | t assign fake_lesson = '{"id": "fake", "name": "' | append: fake_lesson_name | append: '", "course_id": "1", "module_id": "1", "percentage": 0}' | parse_json assign section_items = '' | split: ',' | push: fake_lesson else assign section_items = filtered_last_watched_lessons endif assign should_display_progress = true assign is_horizontal = true assign percentage_field = 'progress' assign path_format = '/{course_id}/{module_id}/{id}' %}{% render 'cards', section: section, section_items: section_items, is_preview: is_preview, source: source, should_display_progress: should_display_progress, is_horizontal: is_horizontal, percentage_field: percentage_field, path_format: path_format %}</section>{% endif %}
