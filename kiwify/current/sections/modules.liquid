{% assign course = all_courses[section.settings.course_id] %}
{% assign filtered_modules_ids = course.modules | reject_exp: 'module_id', 'all_modules[module_id] == undefined' | reject_exp: 'module_id', 'all_modules[module_id].user_data.visible == false and all_modules[module_id].custom_offer.enabled == false and not all_modules[module_id].custom_offer.external_link' %}
{% if filtered_modules_ids.size > 0 or is_preview %}
  {% assign filtered_modules = '' | split: ',' %}{% for module_id in filtered_modules_ids %}{% assign filtered_modules = filtered_modules | push: all_modules[module_id] %}{% endfor %}
  <section id="section__{{ section.id }}" class="kiwi-section relative z-0 hover:z-10 has-[:focus]:z-20 px-6 md:px-12 pb-6 md:pb-12 content-section content-section--modules" data-kiwi-section-id="{{ section.id }}">
    <div class="pt-8">
      <div class="nw-welcome-box"><div class="nw-welcome-content"><h1 class="nw-welcome-title">Seja bem-vindo(a) ao Nutriwork Plus!</h1><p class="nw-welcome-text">Explore os módulos, siga sua trilha de aprendizado e aprenda uma Nutrição realmente Baseada em Evidências.</p><span class="nw-welcome-hint"> Comece pela seção abaixo e avance no seu ritmo. </span></div></div>
      <h2 id="section__{{ section.id }}__title" class="kiwi-section__title font-semibold text-xl drop-shadow-hard-light dark:drop-shadow-hard mb-1 sm:mb-3 flex flex-row items-center gap-2 relative z-20">{{ section.settings.title }}</h2>
      {% if filtered_modules.size > 0 %}{% liquid assign section_items = filtered_modules assign should_display_progress = true assign is_horizontal = false if section.settings.items_layout == 'landscape' assign is_horizontal = true endif assign percentage_field = 'progress' assign path_format = '/{course_id}/{id}' %}{% render 'cards', section: section, section_items: section_items, is_preview: is_preview, source: source, should_display_progress: should_display_progress, is_horizontal: is_horizontal, percentage_field: percentage_field, path_format: path_format %}{% endif %}
    </div>
  </section>
{% endif %}
{% schema %}
{"name":"t:sections.modules.section_title","settings":[{"type":"text","id":"title","label":"t:sections.modules.title.label","placeholder":"t:sections.modules.title.placeholder"},{"type":"select","id":"items_variant","label":"t:sections.modules.items_variant.label","options":[{"value":"content_over","label":"t:sections.modules.items_variant.content_over","kiwi_extra":{"icon":"fas fa-eye"}},{"value":"content_hidden","label":"t:sections.modules.items_variant.content_hidden","kiwi_extra":{"icon":"fas fa-eye-slash"}},{"value":"mouse_hover","label":"t:sections.modules.items_variant.mouse_hover","kiwi_extra":{"icon":"CursorClickIcon"}}],"kiwi_extra":{"labeled":false},"default":"content_over"},{"type":"select","id":"items_layout","label":"t:sections.modules.items_layout.label","options":[{"value":"portrait","label":"t:sections.modules.items_layout.portrait","kiwi_extra":{"icon":"fa fa-portrait"}},{"value":"landscape","label":"t:sections.modules.items_layout.landscape","kiwi_extra":{"icon":"fa fa-image"}}],"kiwi_extra":{"labeled":false},"default":"portrait"},{"type":"course","id":"course_id","label":"t:sections.modules.course_id.label","placeholder":"t:sections.modules.course_id.placeholder"}],"kiwi_extra":{"icon":"fas fa-sitemap"}}
{% endschema %}
