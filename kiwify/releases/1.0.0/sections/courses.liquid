{% if section.settings.all_accessible_courses %}
  {% assign courses = all_courses_values | where: 'user_data.visible', true | sort_natural: 'name' %}
{% else %}
  {% assign filtered_blocks = section.block_order
    | reject_exp: 'block_id', 'all_courses[section.blocks[block_id].settings.course_id] == undefined'
    | reject_exp: 'block_id', 'all_courses[section.blocks[block_id].settings.course_id].user_data.visible == false and all_courses[section.blocks[block_id].settings.course_id].custom_offer.enabled == false and not all_courses[section.blocks[block_id].settings.course_id].custom_offer.external_link'
  %}
  {% assign courses = '' | split: ',' %}
  {% for block_id in filtered_blocks %}
    {% assign courses = courses | push: all_courses[section.blocks[block_id].settings.course_id] %}
  {% endfor %}
{% endif %}

{% if courses.size > 0 or is_preview %}
  <section
    id="section__{{ section.id }}"
    class="kiwi-section nw-section nw-section--{{ section.settings.visual_style | default: 'default' }} px-6 md:px-12 pb-6 md:pb-12"
    data-kiwi-section-id="{{ section.id }}"
    data-nw-accent="{{ section.settings.accent | default: 'blue' }}"
  >
    <div class="nw-section__inner">
      <header class="nw-section__header">
        {% if section.settings.eyebrow != blank %}
          <p class="nw-section__eyebrow">{{ section.settings.eyebrow }}</p>
        {% endif %}
        <h2 id="section__{{ section.id }}__title" class="nw-section__title">{{ section.settings.title }}</h2>
        {% if section.settings.description != blank %}
          <p class="nw-section__description">{{ section.settings.description }}</p>
        {% endif %}
      </header>

      {% if courses.size > 0 %}
        {% liquid
          assign section_items = courses
          assign should_display_progress = true
          assign is_horizontal = false
          if section.settings.items_layout == 'landscape'
            assign is_horizontal = true
          endif
          assign percentage_field = 'progress'
          assign path_format = '/{id}'
        %}
        {% render 'cards',
          section: section,
          section_items: section_items,
          is_preview: is_preview,
          source: source,
          should_display_progress: should_display_progress,
          is_horizontal: is_horizontal,
          percentage_field: percentage_field,
          path_format: path_format
        %}
      {% endif %}
    </div>
  </section>
{% endif %}

{% schema %}
{
  "name": "t:sections.courses.section_title",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "t:sections.courses.title.label",
      "placeholder": "t:sections.courses.title.placeholder"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "t:sections.common.eyebrow.label",
      "placeholder": "t:sections.common.eyebrow.placeholder"
    },
    {
      "type": "text",
      "id": "description",
      "label": "t:sections.common.description.label",
      "placeholder": "t:sections.common.description.placeholder"
    },
    {
      "type": "select",
      "id": "visual_style",
      "label": "t:sections.common.visual_style.label",
      "options": [
        {"value": "default", "label": "t:sections.common.visual_style.default"},
        {"value": "catalog-main", "label": "t:sections.common.visual_style.catalog_main"},
        {"value": "extras", "label": "t:sections.common.visual_style.extras"}
      ],
      "default": "default"
    },
    {
      "type": "select",
      "id": "accent",
      "label": "t:sections.common.accent.label",
      "options": [
        {"value": "blue", "label": "t:sections.common.accent.blue"},
        {"value": "cyan", "label": "t:sections.common.accent.cyan"},
        {"value": "violet", "label": "t:sections.common.accent.violet"},
        {"value": "green", "label": "t:sections.common.accent.green"},
        {"value": "amber", "label": "t:sections.common.accent.amber"},
        {"value": "slate", "label": "t:sections.common.accent.slate"}
      ],
      "default": "blue"
    },
    {
      "type": "text",
      "id": "format_label",
      "label": "t:sections.common.format_label.label"
    },
    {
      "type": "text",
      "id": "category_label",
      "label": "t:sections.common.category_label.label"
    },
    {
      "type": "checkbox",
      "id": "show_content_count",
      "label": "t:sections.common.show_content_count",
      "default": true
    },
    {
      "type": "select",
      "id": "items_variant",
      "label": "t:sections.courses.items_variant.label",
      "options": [
        {"value": "content_over", "label": "t:sections.courses.items_variant.content_over", "kiwi_extra": {"icon": "fas fa-eye"}},
        {"value": "content_hidden", "label": "t:sections.courses.items_variant.content_hidden", "kiwi_extra": {"icon": "fas fa-eye-slash"}},
        {"value": "mouse_hover", "label": "t:sections.courses.items_variant.mouse_hover", "kiwi_extra": {"icon": "CursorClickIcon"}}
      ],
      "kiwi_extra": {
        "labeled": false
      },
      "default": "content_over"
    },
    {
      "type": "select",
      "id": "items_layout",
      "label": "t:sections.courses.items_layout.label",
      "options": [
        {"value": "portrait", "label": "t:sections.courses.items_layout.portrait", "kiwi_extra": {"icon": "fa fa-portrait"}},
        {"value": "landscape", "label": "t:sections.courses.items_layout.landscape", "kiwi_extra": {"icon": "fa fa-image"}}
      ],
      "kiwi_extra": {
        "labeled": false
      },
      "default": "portrait"
    },
    {
      "type": "checkbox",
      "id": "all_accessible_courses",
      "label": "t:sections.courses.all_accessible_courses.label",
      "default": false
    }
  ],
  "kiwi_extra": {
    "icon": "fas fa-graduation-cap",
    "blocks_hidden_if": {
      "setting": "all_accessible_courses",
      "value": true
    }
  },
  "blocks": [
    {
      "type": "course",
      "name": "t:sections.courses.course_id.label",
      "settings": [
        {
          "type": "course",
          "id": "course_id",
          "label": "t:sections.courses.course_id.label",
          "placeholder": "t:sections.courses.course_id.placeholder",
          "kiwi_extra": {
            "icon": "fas fa-book"
          }
        }
      ]
    }
  ]
}
{% endschema %}
