{% assign module = all_modules[section.settings.module_id] %}
{% assign filtered_lessons_ids = module.lessons
  | reject_exp: 'lesson_id', 'all_lessons[lesson_id] == undefined'
  | reject_exp: 'lesson_id', 'all_lessons[lesson_id].user_data.visible == false and all_lessons[lesson_id].custom_offer.enabled == false and not all_lessons[lesson_id].custom_offer.external_link'
%}

{% if filtered_lessons_ids.size > 0 or is_preview %}
  {% assign filtered_lessons = '' | split: ',' %}
  {% for lesson_id in filtered_lessons_ids %}
    {% assign filtered_lessons = filtered_lessons | push: all_lessons[lesson_id] %}
  {% endfor %}

  <section
    id="section__{{ section.id }}"
    class="kiwi-section nw-section nw-section--{{ section.settings.visual_style | default: 'default' }} px-6 md:px-12 pb-6 md:pb-12"
    data-kiwi-section-id="{{ section.id }}"
    data-nw-accent="{{ section.settings.accent | default: 'blue' }}"
  >
    <div class="nw-section__inner">
      <header class="nw-section__header">
        {% if section.settings.eyebrow != blank %}
          <p class="nw-section__eyebrow">{{ section.settings.eyebrow }}</p>
        {% endif %}
        <h2 id="section__{{ section.id }}__title" class="nw-section__title">{{ section.settings.title }}</h2>
        {% if section.settings.description != blank %}
          <p class="nw-section__description">{{ section.settings.description }}</p>
        {% endif %}
      </header>

      {% if filtered_lessons.size > 0 %}
        {% liquid
          assign section_items = filtered_lessons
          assign should_display_progress = true
          assign is_horizontal = false
          if section.settings.items_layout == 'landscape'
            assign is_horizontal = true
          endif
          assign percentage_field = 'progress'
          assign path_format = '/{course_id}/{module_id}/{id}'
        %}
        {% render 'cards',
          section: section,
          section_items: section_items,
          is_preview: is_preview,
          source: source,
          should_display_progress: should_display_progress,
          is_horizontal: is_horizontal,
          percentage_field: percentage_field,
          path_format: path_format
        %}
      {% endif %}

      {% if section.settings.show_support_footer %}
        <aside class="nw-support" aria-labelledby="nw-support-title-{{ section.id }}">
          <div>
            <h3 id="nw-support-title-{{ section.id }}" class="nw-support__title">
              {{ 'support.title' | t }}
            </h3>
            <p class="nw-support__text">{{ 'support.text' | t }}</p>
          </div>
          <div class="nw-support__actions">
            <a class="nw-button" href="{{ section.settings.support_whatsapp }}" target="_blank" rel="noopener noreferrer">
              {{ 'support.whatsapp' | t }}
            </a>
            <a class="nw-button nw-button--secondary" href="mailto:{{ section.settings.support_email }}">
              {{ 'support.email' | t }}
            </a>
          </div>
        </aside>
      {% endif %}
    </div>
  </section>
{% endif %}

{% schema %}
{
  "name": "t:sections.lessons.section_title",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "t:sections.lessons.title.label",
      "placeholder": "t:sections.lessons.title.placeholder"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "t:sections.common.eyebrow.label",
      "placeholder": "t:sections.common.eyebrow.placeholder"
    },
    {
      "type": "text",
      "id": "description",
      "label": "t:sections.common.description.label",
      "placeholder": "t:sections.common.description.placeholder"
    },
    {
      "type": "select",
      "id": "visual_style",
      "label": "t:sections.common.visual_style.label",
      "options": [
        {"value": "default", "label": "t:sections.common.visual_style.default"},
        {"value": "featured", "label": "t:sections.common.visual_style.featured"}
      ],
      "default": "default"
    },
    {
      "type": "select",
      "id": "accent",
      "label": "t:sections.common.accent.label",
      "options": [
        {"value": "indigo", "label": "t:sections.common.accent.indigo"},
        {"value": "blue", "label": "t:sections.common.accent.blue"},
        {"value": "cyan", "label": "t:sections.common.accent.cyan"},
        {"value": "teal", "label": "t:sections.common.accent.teal"},
        {"value": "violet", "label": "t:sections.common.accent.violet"},
        {"value": "orange", "label": "t:sections.common.accent.orange"},
        {"value": "green", "label": "t:sections.common.accent.green"},
        {"value": "amber", "label": "t:sections.common.accent.amber"},
        {"value": "magenta", "label": "t:sections.common.accent.magenta"},
        {"value": "slate", "label": "t:sections.common.accent.slate"}
      ],
      "default": "blue"
    },
    {
      "type": "text",
      "id": "format_label",
      "label": "t:sections.common.format_label.label"
    },
    {
      "type": "text",
      "id": "category_label",
      "label": "t:sections.common.category_label.label"
    },
    {
      "type": "checkbox",
      "id": "show_content_count",
      "label": "t:sections.common.show_content_count",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_support_footer",
      "label": "t:sections.lessons.show_support_footer",
      "default": false
    },
    {
      "type": "text",
      "id": "support_whatsapp",
      "label": "t:sections.lessons.support_whatsapp",
      "default": "https://wa.me/5512997505188"
    },
    {
      "type": "text",
      "id": "support_email",
      "label": "t:sections.lessons.support_email",
      "default": "equipenutriwork@gmail.com"
    },
    {
      "type": "select",
      "id": "items_variant",
      "label": "t:sections.lessons.items_variant.label",
      "options": [
        {"value": "content_over", "label": "t:sections.lessons.items_variant.content_over", "kiwi_extra": {"icon": "fas fa-eye"}},
        {"value": "content_hidden", "label": "t:sections.lessons.items_variant.content_hidden", "kiwi_extra": {"icon": "fas fa-eye-slash"}},
        {"value": "mouse_hover", "label": "t:sections.lessons.items_variant.mouse_hover", "kiwi_extra": {"icon": "CursorClickIcon"}}
      ],
      "kiwi_extra": {
        "labeled": false
      },
      "default": "content_over"
    },
    {
      "type": "select",
      "id": "items_layout",
      "label": "t:sections.lessons.items_layout.label",
      "options": [
        {"value": "portrait", "label": "t:sections.lessons.items_layout.portrait", "kiwi_extra": {"icon": "fa fa-portrait"}},
        {"value": "landscape", "label": "t:sections.lessons.items_layout.landscape", "kiwi_extra": {"icon": "fa fa-image"}}
      ],
      "kiwi_extra": {
        "labeled": false
      },
      "default": "portrait"
    },
    {
      "type": "module",
      "id": "module_id",
      "label": "t:sections.lessons.module_id.label",
      "placeholder": "t:sections.lessons.module_id.placeholder"
    }
  ],
  "kiwi_extra": {
    "icon": "fas fa-bookmark"
  }
}
{% endschema %}
